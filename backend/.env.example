# ==============================================================================
# AI Trade Advisor - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to `.env` (or `backend/.env`) and populate with your actual keys.
# DO NOT commit real secrets or `.env` files to version control.

# ------------------------------------------------------------------------------
# 1. Application & Core Server Settings
# ------------------------------------------------------------------------------
APP_ENV=production
# Generate a unique value, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace_with_a_unique_32_plus_character_secret
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Add only explicit LAN/VPN hosts that run your trusted LLM service.
ALLOWED_LLM_HOSTS=localhost,127.0.0.1,::1,host.docker.internal

# ------------------------------------------------------------------------------
# 2. Database & Cache
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Docker default or local DB)
POSTGRES_USER=trader
POSTGRES_PASSWORD=replace_with_a_unique_database_password
POSTGRES_DB=ai_trade_db
DATABASE_URL=postgresql+asyncpg://trader:replace_with_a_unique_database_password@postgres:5432/ai_trade_db
# Redis connection string
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 3. AI / LLM Model Providers
# ------------------------------------------------------------------------------
# Provider 1: Local LLM (LM Studio / Ollama / LocalAI / OpenAI-compatible endpoint)
LOCAL_LLM_ENDPOINT=http://localhost:1234/v1
LOCAL_LLM_MODEL=llama-3.2-8b

# Provider 2: Google Gemini (Recommended for cloud analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Provider 3: OpenRouter (Multi-model fallback e.g. Claude 3.5 Sonnet / DeepSeek)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ------------------------------------------------------------------------------
# 4. Exchange & Broker Integrations
# ------------------------------------------------------------------------------
# Crypto: Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Phase 4 public real-time market data (no API credentials are sent)
MARKET_STREAM_ENABLED=true
BINANCE_MARKET_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_MARKET_REST_URL=https://data-api.binance.vision
BINANCE_KLINE_INTERVALS=1m,15m,1h,4h,1d
MARKET_STREAM_MAX_SYMBOLS=100
MARKET_STREAM_MAX_RECOVERY_TRADES=5000
MARKET_DATA_STALE_AFTER_SECONDS=10
MARKET_DATA_FALLBACK_STALE_AFTER_SECONDS=45

# Phase 6 Paper execution assumptions (basis points / fractions)
PAPER_OMS_FEE_BPS=10
PAPER_OMS_SPREAD_BPS=5
PAPER_OMS_SLIPPAGE_BPS=3
PAPER_OMS_MAX_VOLUME_PARTICIPATION=0.01
PAPER_OMS_FALLBACK_PARTIAL_FILL_RATIO=0.35
PAPER_OMS_AUTO_BE_TRIGGER_R=1.0
PAPER_OMS_TRAILING_MIN_STEP_R=0.05

# Crypto: Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=

# InnovestX (Digital Assets / Crypto Thailand)
INNOVESTX_API_KEY=
INNOVESTX_API_SECRET=
INNOVESTX_BASE_URL=https://api.innovestxonline.com

# Forex & Gold: MetaTrader 5 (MT5)
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# US Stocks: Alpaca Markets (Paper / Live)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ------------------------------------------------------------------------------
# 5. Alert & Push Notification Channels
# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM Server Key for Mobile Push)
FCM_SERVER_KEY=

# Telegram Bot Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LINE Notify
LINE_NOTIFY_TOKEN=

# ------------------------------------------------------------------------------
# 6. Risk Management & Trading Execution Defaults
# ------------------------------------------------------------------------------
TRADING_MODE=paper               # Safety default only; Live requires POST /api/v1/live/session and is never persisted
DEFAULT_RISK_PER_TRADE=1.0       # Risk percentage per trade (e.g. 1.0 = 1%)
MAX_DAILY_LOSS=3.0               # Max daily loss percentage before circuit breaker
MAX_OPEN_POSITIONS=5             # Maximum concurrent active positions
