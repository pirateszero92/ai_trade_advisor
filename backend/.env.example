# App
APP_ENV=development
APP_SECRET_KEY=changeme
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://trader:trader_pass@localhost:5432/ai_trade_db

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM 1 - Local (LM Studio)
LOCAL_LLM_ENDPOINT=http://localhost:1234/v1
LOCAL_LLM_MODEL=llama-3.2-8b

# LLM 2 - Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# LLM 3 - OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Crypto
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Forex/Gold (MT5)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Stocks
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Notifications
FCM_SERVER_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_NOTIFY_TOKEN=

# Trading
TRADING_MODE=paper

# Risk
DEFAULT_RISK_PER_TRADE=1.0
MAX_DAILY_LOSS=3.0
MAX_OPEN_POSITIONS=5
